<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RearrangedS282</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <GamePath Condition="'$(GamePath)' == ''">B:\SteamLibrary\steamapps\common\Derail Valley</GamePath>
    <ManagedPath>$(GamePath)\DerailValley_Data\Managed</ManagedPath>
    <Version>1.3.0</Version>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <Stage Condition="'$(Stage)' == ''">1</Stage>
    <Version Condition="'$(Stage)' == '3'">1.3.3</Version>
    <DefineConstants Condition="'$(Stage)' == '1'">$(DefineConstants);B99_STAGE1</DefineConstants>
    <DefineConstants Condition="'$(Stage)' == '2'">$(DefineConstants);B99_STAGE2</DefineConstants>
    <DefineConstants Condition="'$(Stage)' == '3'">$(DefineConstants);B99_ALL_STANDARD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedPath)\*.dll" Private="false" />
    <Reference Include="$(ManagedPath)\UnityModManager\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedPath)\UnityModManager\UnityModManager.dll" Private="false" />
    <Reference Include="$(GamePath)\Mods\LocoMeshSplitter\LocoMeshSplitter.dll" Private="false" />
    <!-- The original project's publicizer, operating only on build-local copies. -->
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp;DV.Simulation" IncludeCompilerGeneratedMembers="false" />
    <Compile Remove="Sim\**\*.cs;Patches\DuplexSimPatches.cs;Patches\AddTwoCylinders.cs" />
  </ItemGroup>
</Project>
