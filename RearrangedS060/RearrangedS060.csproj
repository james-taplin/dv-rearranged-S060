<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RearrangedS060</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <GamePath Condition="'$(GamePath)' == ''">B:\SteamLibrary\steamapps\common\Derail Valley</GamePath>
    <ManagedPath>$(GamePath)\DerailValley_Data\Managed</ManagedPath>
    <Version>0.3.1</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <Stage Condition="'$(Stage)' == ''">7</Stage>
    <DefineConstants>$(DefineConstants);B99_S060_FUNCTIONAL;B99_MEYER;B99_DOCKSIDE;B99_S060_ARTICULATED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedPath)\*.dll" Private="false" />
    <Reference Include="$(ManagedPath)\UnityModManager\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedPath)\UnityModManager\UnityModManager.dll" Private="false" />
    <Reference Include="$(GamePath)\Mods\LocoMeshSplitter\LocoMeshSplitter.dll" Private="false" />
    <!-- The original project's publicizer, operating only on build-local copies. -->
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp;DV.Simulation" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>
  <!-- The functional S060 build uses only its own entry point and running gear.
       Inherited S282 radio, save and spawn code cannot be activated accidentally. -->
  <ItemGroup>
    <Compile Include="S060*.cs;B99PhysicsState.cs;ConventionalPhysics.cs;Patches\BogieAxlesPatch.cs" />
    <Compile Include="Meyer*.cs;..\Meyer\Authoring\MeyerPlan.cs;DocksidePhasing.cs;DocksideBody.cs" />
  </ItemGroup>
  <Target Name="RequireCurrentProduct" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Stage)' != '7'" Text="Historical prototype stages are archived. Build the current product with Build.Runtime.ps1 (Stage7)." />
  </Target>
</Project>
